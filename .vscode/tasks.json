{
  // These tasks are used in neovim through overseer.nvim! They can ALSO be used in VSCode.
  // These task are specifically made in windows OS and may not all run on Linux!
  // These tasks rely on having certain commands available in PATH (e.g., lua to execute lua scripts).
  // https://code.visualstudio.com/docs/debugtest/tasks#_custom-tasks
  // https://github.com/stevearc/overseer.nvim/blob/master/doc/guides.md#vs-code-tasks
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Local Release Build",
      "type": "shell",
      "dependsOrder": "sequence",
      "dependsOn": [
        "index to root",
        "Trunk Build Local",
        "esbuild minify css",
        "esbuild bundle js",
        "esbuild minify bundled js",
        "esbuild minify 3d_sorting js",
        "rm root index"
        // usually followed up with live-server task
      ],
      "group": "build"
    },
    {
      "label": "Github Exe Release Build",
      "type": "shell",
      "dependsOrder": "sequence",
      "dependsOn": [
        "build release exe",
        "zip release exe",
        "open release dir",
        "open release webpage"
      ],
      "group": "build"
    },
    {
      "label": "Github Web Release Build",
      "type": "shell",
      "dependsOrder": "sequence",
      "dependsOn": [
        "index to root",
        "Trunk Build Release",
        "esbuild minify css",
        "esbuild bundle js",
        "esbuild minify bundled js",
        "esbuild minify 3d_sorting js",
        "rm root index"
      ],
      "group": "build"
    },
    {
      "label": "Dev Build",
      "type": "shell",
      "dependsOrder": "sequence",
      "dependsOn": [
        "index to root",
        "Trunk Build Dev",
        "esbuild bundle js",
        "rm root index"
      ],
      "group": "build"
    },
    {
      "label": "gzip size (wasm)",
      "type": "shell",
      "command": "scripts\\gzip_wasm_size.ps1",
      "group": "build",
    },
    {
      "label": "live-server",
      "type": "shell",
      "command": "live-server ./docs --browser=\"$(cat scripts/browser_path.txt)\"",
      "group": "none",
    },
    {
      "label": "Trunk Build Release",
      "type": "shell", // shell or process
      // For release build on Github:
      "command": "trunk build --release --cargo-profile release-wasm32 --filehash false --public-url /3D-Sorting-Visualizer/",
      "group": "build",
      "presentation": {
        "reveal": "always", // always reveal terminal
        // "panel": "new" // always create new terminal
      }
    },
    {
      "label": "Trunk Build Local",
      "type": "shell",
      "command": "trunk build --release --cargo-profile release-wasm32 --filehash false",
      "group": "build",
      "presentation": {
        "reveal": "always",
      }
    },
    {
      "label": "Trunk Build Dev",
      "type": "shell",
      "command": "trunk build --filehash false",
      "group": "build",
      "presentation": {
        "reveal": "always",
      }
    },
    {
      "label": "index to root",
      // trunk needs index.html to be in the same directory as cargo.toml in order to build correctly.
      // copies index.html from source to root (where cargo.toml is)
      "type": "shell",
      "command": "cp src/index.html index.html",
      "group": "build"
    },
    {
      "label": "rm root index",
      "type": "shell",
      "command": "rm index.html",
      "group": "build"
    },
    {
      "label": "esbuild minify css",
      "type": "shell",
      "command": "npx esbuild src/index.css --minify --outfile=docs/index.css --allow-overwrite",
      "group": "build"
    },
    {
      "label": "esbuild bundle js",
      "type": "shell",
      "command": "npx esbuild src/main.js --bundle --format=esm --outfile=docs/main.js --allow-overwrite",
      "group": "build"
    },
    {
      "label": "esbuild minify bundled js",
      "type": "shell",
      "command": "npx esbuild docs/main.js --minify --outfile=docs/main.js --allow-overwrite",
      "group": "build"
    },
    {
      "label": "esbuild minify 3d_sorting js",
      "type": "shell",
      "command": "npx esbuild docs/rust_3d_sorting.js --minify --outfile=docs/rust_3d_sorting.js --allow-overwrite",
      "group": "build"
    },
    // exe
    {
      "label": "build release exe",
      "type": "shell",
      "command": "cargo build --release",
      "group": "build"
    },
    {
      "label": "zip release exe",
      "type": "shell",
      "command": "cd target/release && 7z a -tzip -aoa 3D_Sorting_Visualizer \"3D_Sorting_Visualizer.exe\"",
      "group": "build"
    },
    {
      "label": "open release dir",
      "type": "shell",
      "command": "explorer target\\release",
    },
    {
      "label": "open release webpage",
      "type": "shell",
      "command": "start https://github.com/ArshvirGoraya/3D-Sorting-Visualizer/releases",
    },
  ]
}
